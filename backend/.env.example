# Django Configuration
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Django Configuration
SECRET_KEY=replace-me-with-a-strong-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Database Configuration
# Recommended (production): provide a single DATABASE_URL
# Example Postgres DATABASE_URL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=

# Optional individual DB settings (used when DATABASE_URL is empty)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Connection pooling / conn max age (seconds)
DB_CONN_MAX_AGE=600

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (example using SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# CORS Configuration (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=

# Frontend API base (used by Vite as VITE_API_URL)
VITE_API_URL=http://localhost:8000/api/

# Other
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY_PLACEHOLDER=replace-me

# SaaS tenancy and trial signup
TENANT_BASE_DOMAIN=
TENANT_DEFAULT_SLUG=default
TENANT_ALLOW_DEFAULT_CONTEXT=False
TENANT_TRIAL_DAYS=14
TENANT_SIGNUP_RATE=10/hour
PUBLIC_APP_URL=http://localhost:3000

# Production reverse-proxy settings. Enable TRUST_PROXY_SSL_HEADER only when
# the app is reachable exclusively through a trusted HTTPS-terminating proxy.
TRUST_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Stripe billing (configure approved Stripe price IDs before enabling checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
